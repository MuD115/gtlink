<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ equivalent of backup_rules.xml. Pairing keys live in shared preferences
  and must not follow the user to a new phone, whether via cloud backup or a direct
  device-to-device transfer: the watch is paired to the old phone, not the new one.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
